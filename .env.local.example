# Copy this file to .env.local and add your own Gemini API key.
GOOGLE_GENERATIVE_AI_API_KEY=

# Google account sign-in (all values stay server-side).
# Register the exact callback URL in Google Cloud; see AUTH_SETUP.md.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database/authentication; never expose these as NEXT_PUBLIC variables.
# SUPABASE_DB_PASSWORD is used only by the manual role-provisioning script.
SUPABASE_DB_PASSWORD=
# Generated restricted role URLs; DATABASE_AUTH_URL activates permanent accounts.
DATABASE_URL=
DATABASE_AUTH_URL=

# Email sender: Resend API key and authorized sending address, server-only.
# Missing values disable signup/resend/recovery email; links are never logged.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Required with onboarding@resend.dev; only this address can register/request email.
# Remove this restriction only after configuring a verified custom sending domain.
AUTH_EMAIL_TEST_RECIPIENT=
