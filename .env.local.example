# Copy this file to .env.local and add your own Gemini API key.
GOOGLE_GENERATIVE_AI_API_KEY=

# Google account sign-in (all values stay server-side).
# Register the exact callback URL in Google Cloud; see AUTH_SETUP.md.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database setup only; never expose these as NEXT_PUBLIC variables.
# SUPABASE_DB_PASSWORD is used only by the manual role-provisioning script.
SUPABASE_DB_PASSWORD=
# Generated restricted role URLs; app/profile integration is a later stage.
DATABASE_URL=
DATABASE_AUTH_URL=
